{
  "openapi": "3.0.3",
  "info": {
    "title": "Synthetic Juniper Bank novel schema",
    "version": "1.0-local",
    "description": "Synthetic local-only adaptation input. No live service exists. customer_id is supplied by the test operator, never invented by the generator."
  },
  "servers": [
    {
      "url": "https://juniper-bank.example.invalid/v7"
    }
  ],
  "components": {},
  "paths": {
    "/security/check": {
      "post": {
        "summary": "Check one security answer. Four wrong answers in total end the check.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string",
                    "enum": [
                      "birth_date",
                      "family_code"
                    ]
                  },
                  "answer": {
                    "type": "string",
                    "description": "For birth_date: date of birth as YYYY-MM-DD. Unreadable input returns ok=false, records no wrong answer. family_code is four digits."
                  }
                },
                "required": [
                  "customer_id",
                  "field",
                  "answer"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "verified": {
                      "type": "boolean"
                    },
                    "wrong_answers_left": {
                      "type": "integer"
                    },
                    "all_verified": {
                      "type": "boolean"
                    },
                    "hint": {
                      "type": "string",
                      "enum": [
                        "day_month_swapped"
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "verify_identity"
      }
    },
    "/accounts/read": {
      "post": {
        "summary": "The late products. Refused until both questions are passed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "customer_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "credit_card",
                              "personal_loan",
                              "car_loan"
                            ]
                          },
                          "card_last4": {
                            "type": "string",
                            "description": "credit cards only"
                          },
                          "arrears_balance": {
                            "type": "number"
                          },
                          "days_late": {
                            "type": "integer"
                          },
                          "required_minimum": {
                            "type": "number",
                            "description": "credit cards only"
                          },
                          "scheduled_due": {
                            "type": "number",
                            "description": "loans only"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "get_account"
      }
    },
    "/payment-promises/record": {
      "post": {
        "summary": "Record a payment promise. One per product.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "product_id": {
                    "type": "string"
                  },
                  "pledged_amount": {
                    "type": "number"
                  },
                  "payment_date": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "customer_id",
                  "product_id",
                  "pledged_amount",
                  "payment_date"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok=true confirms a recorded promise; explicit ok=false records nothing and is safe to retry subject to the brief.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "promise_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "create_promise"
      }
    },
    "/notes/create": {
      "post": {
        "summary": "Brief B: record why a product ended without a promise.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "product_id": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "refused",
                      "hardship",
                      "dispute",
                      "paid",
                      "service_error"
                    ]
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "customer_id",
                  "product_id",
                  "reason"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "add_note"
      }
    },
    "/callbacks/book": {
      "post": {
        "summary": "Book a callback.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "payment_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "time": {
                    "type": "string",
                    "description": "HH:MM"
                  }
                },
                "required": [
                  "customer_id",
                  "payment_date",
                  "time"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "schedule_callback"
      }
    },
    "/calls/transfer": {
      "post": {
        "summary": "Hand the call to a person.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "queue": {
                    "type": "string",
                    "enum": [
                      "restructuring",
                      "general",
                      "support"
                    ]
                  }
                },
                "required": [
                  "customer_id",
                  "queue"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "transfer_to_agent"
      }
    },
    "/calls/finish": {
      "post": {
        "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "commitment",
                      "paid",
                      "transferred",
                      "no_promise",
                      "not_verified",
                      "not_reached"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Required for every outcome except commitment and paid. Values are defined by the supplied brief."
                  }
                },
                "required": [
                  "customer_id",
                  "outcome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        },
        "operationId": "close_call"
      }
    }
  }
}
